# Absolute paths, paths beginning with ~, and project-relative paths are supported.
COURSE_PATH=course

EDUCATOR_LLM_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest

# Required only when EDUCATOR_LLM_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_USE_GOOGLE_SEARCH=false
# Minimal is recommended for structured JSON generation and avoids spending
# the response budget on hidden reasoning. Allowed: minimal, low, medium, high.
GEMINI_THINKING_LEVEL=minimal

# Complete model prompts and responses are written locally for debugging.
LLM_LOG_ENABLED=true
LLM_LOG_PATH=logs/llm_io.jsonl
